---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" href="/favicon.ico" />

        <link rel="preload" as="image" href="/images/Ability.webp" />
        <link rel="preload" as="image" href="/images/Sora Heart.webp" />
        <link rel="preload" as="image" href="/images/Menu Glove.webp" />
        <link rel="preload" as="image" href="/images/Menu Light.webp" />

        <link
            rel="preload"
            href="/fonts/kh/KHMenu.otf"
            as="font"
            type="font/otf"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/kh/KHTitle.otf"
            as="font"
            type="font/otf"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/kh/KHGummi.otf"
            as="font"
            type="font/otf"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/kh/KHData.otf"
            as="font"
            type="font/otf"
            crossorigin
        />
        <meta name="generator" content={Astro.generator} />
        <link
            rel="preload"
            href="/videos/background-animation.webm"
            as="video"
            type="video/webm"
            fetchpriority="high"
        />
        <title>Astro Basics</title>
    </head>
    <body class="">
        <slot />

        <video
            id="background-video"
            autoplay
            loop
            muted
            poster="/images/background-poster.webp"
        >
            <source src="/videos/background-animation.webm" type="video/webm" />
        </video>
    </body>
</html>
